<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DukeBox.view.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DukeBox.view"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="./Converters.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar-->
            <RowDefinition Height="*"/>     <!-- content -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>   <!-- item list -->
            <ColumnDefinition Width="1*"/>   <!-- log view -->
        </Grid.ColumnDefinitions>
        
        <!-- toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="36" Spacing="4" HorizontalAlignment="Left">
            <TextBlock Text="Channel" VerticalAlignment="Center"/>
            <DropDownButton Content="{x:Bind ViewModel.SelectedCategory.Value.Name, Mode=OneWay}" xmlns:model="using:DukeBox.model">
                <DropDownButton.Flyout>
                    <Flyout x:Name="categoryFlyout" Placement="BottomEdgeAlignedLeft">
                        <ListView ItemsSource="{x:Bind ViewModel.CategoryList}" SelectionMode="Single" MaxHeight="400"
                                  SelectedItem="{x:Bind ViewModel.SelectedCategory.Value, Mode=TwoWay}"
                                  SelectionChanged="OnCategorySelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="model:ICategory">
                                    <TextBlock Text="{x:Bind Name}"/>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <CheckBox 
                Content="Type" HorizontalAlignment="Left" MinWidth="0" Margin="12,0,4,0"
                IsChecked="{x:Bind ViewModel.TypeFilterEnabled.Value, Mode=TwoWay}"
                />
            <StackPanel 
                Orientation="Horizontal" Spacing="1"
                Visibility="{x:Bind ViewModel.TypeFilterEnabled.Value, Mode=OneWay}">
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.TypeVideoChecked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xE714;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.TypeAudioChecked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xE8D6;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.TypePhotoChecked.Value, Mode=TwoWay}">

                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xEB9F;"/>
                    </Viewbox>
                </ToggleButton>
            </StackPanel>
            
            <CheckBox 
                Content="Rating" HorizontalAlignment="Left" MinWidth="0" Margin="12,0,4,0"
                IsChecked="{x:Bind ViewModel.RatingFilterEnabled.Value, Mode=TwoWay}"/>
            <StackPanel 
                Orientation="Horizontal" Spacing="1"
                Visibility="{x:Bind ViewModel.RatingFilterEnabled.Value, Mode=OneWay}">
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Rating1Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xF146;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Rating2Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xF147;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Rating3Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xF148;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Rating4Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xF149;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Rating5Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xF14A;"/>
                    </Viewbox>
                </ToggleButton>
            </StackPanel>
            
            <!-- Mark -->

            <CheckBox 
                Content="Mark" MinWidth="0" Margin="12,0,4,0"
                IsChecked="{x:Bind ViewModel.MarkFilterEnabled.Value, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal" Spacing="1"
                Visibility="{x:Bind ViewModel.MarkFilterEnabled.Value, Mode=OneWay}">
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Mark0Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xE739;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Mark1Checked.Value, Mode=TwoWay}">

                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xE734;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Mark2Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xE81B;"/>
                    </Viewbox>
                </ToggleButton>
                <ToggleButton Padding="5" IsChecked="{x:Bind ViewModel.Mark3Checked.Value, Mode=TwoWay}">
                    <Viewbox Width="12" Height="12">
                        <FontIcon Glyph="&#xEB51;"/>
                    </Viewbox>
                </ToggleButton>
            </StackPanel>

        </StackPanel>

        <Button Grid.Row="0" Grid.Column="1" Content="Stop Server" Command="{x:Bind ViewModel.StopServerCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

        <!-- content -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Media Files"/>
            <tv:TableView 
                Grid.Row="1"
                x:Name="tableView" 
                xmlns:vm="using:DukeBox.model"
                ItemsSource="{x:Bind ViewModel.MediaFiles}" 
                AutoGenerateColumns="false"
                BeginningEdit="OnBeginningEdit"
                CellEditEnding="OnCellEditing"
                CellEditEnded="OnCellEdited"
                CellDoubleTapped="OnCellDoubleTapped"
                RowDoubleTapped="OnRowDoubleTapped"
                SelectionUnit="CellWithRow"
                >
                <tv:TableView.Columns>

                    <!-- Type: アイコン表示 -->
                    <tv:TableViewTemplateColumn Header="" Width="50" IsReadOnly="True"
                        SortMemberPath="Type" CanSort="True">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:IMediaFile">
                                <FontIcon Glyph="{x:Bind Type, Converter={StaticResource MediaTypeToGlyphConverter}}" FontSize="16"/>
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>

                    <!-- Name: 編集可能 -->
                    <tv:TableViewTextColumn 
                    Header="Name" 
                    Binding="{Binding Name}" 
                    Width="*"/>

                    <!-- Size: 3 桁区切り / 編集不可 -->
                    <tv:TableViewTextColumn 
                        Header="Size" IsReadOnly="True"
                        CanFilter="False"
                        CanGroup="False"
                    Binding="{Binding Size, Converter={StaticResource ThousandsSeparatorConverter}}"
                    Width="100">
                        <tv:TableViewTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </tv:TableViewTextColumn.ElementStyle>
                    </tv:TableViewTextColumn>

                    <!-- Date: 整形 / 編集不可 -->
                    <tv:TableViewTextColumn 
                        Header="Created" IsReadOnly="True"
                        CanFilter="False"
                        CanGroup="False"
                    Binding="{Binding CreationDate, Converter={StaticResource UnixMsToDateStringConverter}}"
                    Width="140"/>

                    <!-- Category: 編集不可 -->
                    <tv:TableViewTextColumn 
                    Header="Channel" 
                    Binding="{Binding CategoryName}" 
                    Width="85" 
                    IsReadOnly="True"/>

                    <!-- bool: チェックアイコン / 編集不可 
                    <tv:TableViewTemplateColumn Header="Converted" IsReadOnly="True" Width="*">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:IMediaFile">
                                <FontIcon Glyph="&#xE73E;"
                              Visibility="{x:Bind Converted, Converter={StaticResource BoolVisibilityConverter}}"/>
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    -->

                    <tv:TableViewTemplateColumn Header="Rating" Width="50"
                        SortMemberPath="ComplementalRating" CanSort="True">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:IMediaFile">
                                <TextBlock Text="{x:Bind Rating}" HorizontalAlignment="Center"/>
                                <!--
                                <Viewbox Width="20" Height="20">
                                    <Path Width="24" Height="24"
                                          Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                          Data="{x:Bind ComplementalRating, Converter={StaticResource RatingToGeometryConverter}}"/>
                                </Viewbox>
                                -->
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    
                    <!-- Path: 編集不可 -->
                    <tv:TableViewTextColumn 
                    Header="Path" 
                    Binding="{Binding Path}" 
                    IsReadOnly="True"
                        CanGroup="False"
                    Width="*"/>
                </tv:TableView.Columns>
            </tv:TableView>
        </Grid>

        <!-- log view -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log"/>
            <local:LogView Grid.Row="1"/>
        </Grid>

    </Grid>
</Page>
