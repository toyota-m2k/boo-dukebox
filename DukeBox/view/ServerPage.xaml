<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DukeBox.view.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DukeBox.view"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary Source="./Converters.xaml"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- toolbar-->
            <RowDefinition Height="*"/>     <!-- content -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>   <!-- item list -->
            <ColumnDefinition Width="1*"/>   <!-- log view -->
        </Grid.ColumnDefinitions>
        
        <!-- toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Height="36" HorizontalAlignment="Left">
            <Button Content="Stop Server" Command="{x:Bind ViewModel.StopServerCommand}"/>
        </StackPanel>
        
        <!-- content -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Media Files"/>
            <tv:TableView 
                Grid.Row="1"
                x:Name="tableView" 
                xmlns:vm="using:DukeBox.model"
                ItemsSource="{x:Bind ViewModel.MediaFiles}" 
                AutoGenerateColumns="false"
                BeginningEdit="OnBeginningEdit"
                CellEditEnding="OnCellEditing"
                CellEditEnded="OnCellEdited"
                CellDoubleTapped="OnCellDoubleTapped"
                RowDoubleTapped="OnRowDoubleTapped"
                SelectionUnit="CellWithRow"
                >
                <tv:TableView.Columns>

                    <!-- Type: アイコン表示 -->
                    <tv:TableViewTemplateColumn Header="Type" Width="50" IsReadOnly="True">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:IMediaFile">
                                <FontIcon Glyph="{x:Bind Type, Converter={StaticResource MediaTypeToGlyphConverter}}" FontSize="16"/>
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>

                    <!-- Name: 編集可能 -->
                    <tv:TableViewTextColumn 
                    Header="Name" 
                    Binding="{Binding Name}" 
                    Width="*"/>

                    <!-- Size: 3 桁区切り / 編集不可 -->
                    <tv:TableViewTextColumn Header="Size" IsReadOnly="True"
                    Binding="{Binding Size, Converter={StaticResource ThousandsSeparatorConverter}}"
                    Width="*"/>

                    <!-- Date: 整形 / 編集不可 -->
                    <tv:TableViewTextColumn Header="Created" IsReadOnly="True"
                    Binding="{Binding CreationDate, Converter={StaticResource UnixMsToDateStringConverter}}"
                    Width="*"/>

                    <!-- Category: 編集不可 -->
                    <tv:TableViewTextColumn 
                    Header="Category" 
                    Binding="{Binding CategoryName}" 
                    Width="80" 
                    IsReadOnly="True"/>

                    <!-- bool: チェックアイコン / 編集不可 -->
                    <tv:TableViewTemplateColumn Header="Converted" IsReadOnly="True" Width="*">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:IMediaFile">
                                <FontIcon Glyph="&#xE73E;"
                              Visibility="{x:Bind Converted, Converter={StaticResource BoolVisibilityConverter}}"/>
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>

                    <!-- Path: 編集不可 -->
                    <tv:TableViewTextColumn 
                    Header="Path" 
                    Binding="{Binding Path}" 
                    IsReadOnly="True"
                    Width="*"/>
                </tv:TableView.Columns>
            </tv:TableView>
        </Grid>

        <!-- log view -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log"/>
            <local:LogView Grid.Row="1"/>
        </Grid>

    </Grid>
</Page>
